@{
    ViewData["Title"] = "Home Page";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/speciality.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/list-specility.css" asp-append-version="true" />
<div class="container my-5">
    <div class="body">
        <div id="homeCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="~/images/091959-dr-marie.png" class="d-block w-100 slide-img" alt="Slide 1">
                </div>
                <div class="carousel-item">
                    <img src="~/images/163614-da-lieu-sg.png" class="d-block w-100 slide-img" alt="Slide 2">
                </div>
                <div class="carousel-item">
                    <img src="~/images/164514-da-lieu-thai-ha.png" class="d-block w-100 slide-img" alt="Slide 3">
                </div>
                <div class="carousel-item">
                    <img src="~/images/165707-mediplus.png" class="d-block w-100 slide-img" alt="Slide 4">
                </div>
            </div>
        </div>
    </div>
</div>
<div>
    <section class="container my-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="fw-bold">Chuyên khoa</h3>
            <a asp-controller="Home" asp-action="Index2"
               class="btn btn-info text-white rounded-pill px-3">
                Xem thêm
            </a>
        </div>
        <div id="specialtyCarousel" class="carousel slide" data-bs-ride="false">
            <div class="carousel-inner" id="specialtyCarouselInner">
            </div>
            <button class="carousel-control-prev" type="button"
                    data-bs-target="#specialtyCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon bg-info rounded-circle p-3"></span>
            </button>
            <button class="carousel-control-next" type="button"
                    data-bs-target="#specialtyCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon bg-info rounded-circle p-3"></span>
            </button>
        </div>
    </section>
    <section class="container my-5">
        <h2 class="text-center mb-4 fw-bold" style="color:#45C3D2">
            Bác sĩ nổi bật
        </h2>
        <a asp-controller="Home" asp-action="Index3"
           class="btn btn-info text-white rounded-pill px-3 add"
           style="position: relative; z-index: 10;">
            Xem thêm
        </a>
        <div id="doctorCarousel" class="carousel slide" data-bs-ride="false">
            <div class="carousel-inner" id="doctorCarouselInner"></div>

            <button class="carousel-control-prev" type="button"
                    data-bs-target="#doctorCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon bg-info rounded-circle p-3"></span>
            </button>

            <button class="carousel-control-next" type="button"
                    data-bs-target="#doctorCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon bg-info rounded-circle p-3"></span>
            </button>
        </div>
    </section>

</div>
<script>
    document.addEventListener("DOMContentLoaded", async () => {
        const res = await fetch("/api/AllSpecialty");
        const data = await res.json();

        const chunkSize = 3;
        const carouselInner = document.getElementById("specialtyCarouselInner");

        carouselInner.innerHTML = ""; 

        for (let i = 0; i < data.length; i += chunkSize) {
            const chunk = data.slice(i, i + chunkSize);
            const isActive = i === 0 ? "active" : "";

            let itemsHtml = "";
            chunk.forEach(item => {
            itemsHtml += `
        <div class="col-md-4">
            <a href="/Specialty/Detail/${item.id}"
               class="specialty-card h-100 text-decoration-none text-dark d-block">
                <img src="${item.imageUrl}" alt="${item.name}">
                <h6 class="fw-bold mt-2">${item.name}</h6>
                <p class="mb-0">${item.description ?? ""}</p>
            </a>
        </div>
    `;
            });

            carouselInner.insertAdjacentHTML("beforeend", `
                <div class="carousel-item ${isActive}">
                    <div class="row g-4">
                        ${itemsHtml}
                    </div>
                </div>
            `);
        }
        const carouselElement = document.getElementById("specialtyCarousel");
        new bootstrap.Carousel(carouselElement, {
            interval: false,
            ride: false,
            wrap: true
        });
    });
        document.addEventListener("DOMContentLoaded", async () => {
        const res = await fetch("/api/AllDoctor");
        const data = await res.json();

        const chunkSize = 4; // giống layout cũ
        const carouselInner = document.getElementById("doctorCarouselInner");
        carouselInner.innerHTML = "";

        for (let i = 0; i < data.length; i += chunkSize) {
            const chunk = data.slice(i, i + chunkSize);
            const isActive = i === 0 ? "active" : "";

            let itemsHtml = "";
            chunk.forEach(item => {
    itemsHtml += `
        <div class="col-md-3 col-sm-6">
            <a href="/Doctor/Detail/${item.id}"
               class="doctor-specialty-card h-100 text-decoration-none text-dark d-block">
                <img src="${item.imageUrl}" alt="${item.name}">
                <h6 class="fw-bold mt-2">${item.name}</h6>
                <p class="mb-0">Chuyên khoa ${item.specialty}</p>
            </a>
        </div>
    `;

            });

            carouselInner.insertAdjacentHTML("beforeend", `
                <div class="carousel-item ${isActive}">
                    <div class="row g-4">
                        ${itemsHtml}
                    </div>
                </div>
            `);
        }

        new bootstrap.Carousel(document.getElementById("doctorCarousel"), {
            interval: false,
            ride: false,
            wrap: true
        });
    });

</script>