@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> signInManager
@inject UserManager<ApplicationUser> userManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookingCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookingCare.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bookingcare.css" />
    <link rel="stylesheet" href="~/css/home_page.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark booking-navbar">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="Patient" asp-controller="Home" asp-action="Index">
                    <img src="~/images/BookingCareLogo.png"
                         alt="BookingCare Logo"
                         class="d-inline-block align-text-top booking-logo" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="Patient" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        @if (signInManager.IsSignedIn(User))
                        {
                            if (User.IsInRole("Patient"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-area="Patient" asp-controller="PatientBooking" asp-action="Index">Đặt lịch khám</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-area="Patient" asp-controller="BookingHistory" asp-action="Index">Lịch đặt</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-area="Patient" asp-controller="AccountManager" asp-action="Index">Tài khoản</a>
                                </li>
                            }

                            else if (User.IsInRole("Doctor"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-area="Doctor" asp-controller="Doctors" asp-action="Index">Lịch khám</a>
                                </li>
      
                            }
                        }
                    </ul>
                    <!-- Hiển thị đăng nhập / đăng xuất -->
                    <ul class="navbar-nav">
                        @if (signInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline"
                                      onsubmit="return confirm('Bạn có chắc chắn muốn đăng xuất không?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link nav-link text-white">Đăng xuất</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Account" asp-action="RegisterStep1">Đăng ký</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <div>
        <footer class="booking-footer text-white mt-5">
            <div class="container text-center py-3">
                <p class="mb-1 fw-bold">© 2025 BookingCare Việt Nam</p>
                <small>Liên hệ: support@bookingcare.vn | Hotline: 1900 1234  <a class="text-white fw-bold" asp-area="" asp-controller="Home" asp-action="Privacy">Chính sách</a></small>
            </div>
        </footer>
    </div>
    <<!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Bootstrap Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery Easing -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-easing/1.4.1/jquery.easing.min.js"></script>
    <!-- SignalR -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    @await RenderSectionAsync("Styles", required: false)
</body>
</html>
