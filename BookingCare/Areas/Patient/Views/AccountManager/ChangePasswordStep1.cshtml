@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "_Layout";
}

<div class="bc-wrapper">
    <div class="bc-card">
        <h3 class="bc-title">Đổi mật khẩu</h3>
        <form id="changePasswordStep1Form">
            <div class="form-group mb-3">
                <label for="oldPassword" class="bc-label">Mật khẩu hiện tại</label>
                <input id="oldPassword" type="password" class="form-control bc-input" placeholder="Nhập mật khẩu hiện tại" />
            </div>
            <div class="form-group mb-3">
                <label for="newPassword" class="bc-label">Mật khẩu mới</label>
                <input id="newPassword" type="password" class="form-control bc-input" placeholder="Nhập mật khẩu mới" />
            </div>
            <div class="form-group mb-4">
                <label for="confirmNewPassword" class="bc-label">Xác nhận mật khẩu mới</label>
                <input id="confirmNewPassword" type="password" class="form-control bc-input" placeholder="Nhập lại mật khẩu mới" />
            </div>
            <button type="submit" class="bc-btn">
                Đổi mật khẩu
            </button>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/change_password_step1.css" />
}

@section Scripts {
    <script src="~/js/change_password.js"></script>
}
