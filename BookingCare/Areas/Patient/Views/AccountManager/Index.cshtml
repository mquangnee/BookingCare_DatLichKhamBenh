@{
    ViewData["Title"] = "Cập nhật tài khoản bệnh nhân";
    Layout = "_Layout";
}

<div class="container mt-4">
    <!-- HEADER -->
    <h2 class="text-center fw-bold mb-4" style="color:#45c3d2;">
        <i class="fa fa-user-edit me-2"></i> Cập nhật thông tin cá nhân
    </h2>
    <!-- FORM -->
    <form id="updateInfor" class="bg-white shadow p-4 rounded-4 border" style="max-width: 650px; margin:auto;">
        <!-- Họ tên -->
        <div class="mb-3">
            <label for="fullName" class="form-label fw-semibold text-dark">Họ tên</label>
            <input id="fullName" type="text" class="form-control rounded-pill" placeholder="Nhập họ và tên" />
        </div>

        <!-- Giới tính -->
        <div class="mb-3">
            <label class="form-label fw-semibold text-dark">Giới tính</label>
            <div class="mt-1">
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="gender" id="male" value="Nam">
                    <label class="form-check-label" for="male">Nam</label>
                </div>

                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="gender" id="female" value="Nữ">
                    <label class="form-check-label" for="female">Nữ</label>
                </div>
            </div>
        </div>

        <!-- Ngày sinh -->
        <div class="mb-3">
            <label for="dateOfBirth" class="form-label fw-semibold text-dark">Ngày sinh</label>
            <input id ="dateOfBirth" type="date" class="form-control rounded-pill" />
        </div>

        <!-- Địa chỉ -->
        <div class="mb-3">
            <label for="address" class="form-label fw-semibold text-dark">Địa chỉ</label>
            <input id ="address" type="text" class="form-control rounded-pill" placeholder="Nhập địa chỉ của bạn" />
        </div>

        <!-- SĐT -->
        <div class="mb-3">
            <label for="phoneNumber" class="form-label fw-semibold text-dark">Số điện thoại</label>
            <input id ="phoneNumber" type="tel" class="form-control rounded-pill" placeholder="Nhập số điện thoại" pattern="[0-9]{10}" />
        </div>

        <!-- Tiền sử bệnh -->
        <div class="mb-3">
            <label for="medicalHistory" class="form-label fw-semibold text-dark">Tiền sử bệnh</label>
            <textarea id="medicalHistory" class="form-control booking-control" rows="5" style="resize:none;" placeholder="Nhập tiền sử bệnh..."></textarea>
        </div>

        <!-- BUTTONS -->
        <div class="text-center mt-4">
            <button type="submit" class="btn px-4 rounded-pill text-white" style="background-color:#45c3d2;">
                <i class="fa fa-save me-1"></i> Lưu thay đổi
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/patient_account_manager.js"></script>
}
@section Styles {
    <link rel="stylesheet" href="~/css/patient_account_manager.css" />
}