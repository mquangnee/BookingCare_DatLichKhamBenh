@{
    Layout = "_Layout";
}

<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Dashboard</h1>
</div>

<!-- Content Row -->
<div class="row">

    <!-- Thống kê số bác sĩ đang hoạt động của phòng khám -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                            Số bác sĩ
                        </div>
                        <div id="totalDoctors" class="h4 mb-0 font-weight-bold text-gray-800"></div>
                    </div>
                    <div class="col-auto">
                        <i class="fa-solid fa-user-doctor fa-2x text-black-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Thống kê số bệnh nhân của phòng khám -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                            Số bệnh nhân
                        </div>
                        <div id="totalPatients" class="h4 mb-0 font-weight-bold text-gray-800"></div>
                    </div>
                    <div class="col-auto">
                        <i class="fa-solid fa-hospital-user fa-2x text-black-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Thống kê số lịch hẹn của phòng khám hôm nay -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                            Số lịch khám hôm nay
                        </div>
                        <div id="totalApptToday" class="h4 mb-0 font-weight-bold text-gray-800"></div>
                    </div>
                    <div class="col-auto">
                        <i class="fa-solid fa-calendar-days fa-2x text-black-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Thống kê số lịch hẹn đã hủy của phòng khám hôm nay -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-warning shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                            Số lịch khám đã hủy
                        </div>
                        <div id="totalCanceledApptToday" class="h4 mb-0 font-weight-bold text-gray-800"></div>
                    </div>
                    <div class="col-auto">
                        <i class="fa-solid fa-ban fa-2x text-black-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Content Row -->
<div class="row">

    <!-- BẢNG THỐNG KÊ BÁC SĨ -->
    <div class="col-xl-4 col-lg-5 mb-4">
        <div class="card shadow-sm h-100">

            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">
                    Thống kê lịch khám theo bác sĩ
                </h6>

                <div class="d-flex">
                    <input type="date" id="statDate"
                           class="form-control form-control-sm mr-2" />
                    <button id="btnLoadStat"
                            class="btn btn-sm btn-primary">
                        Xem
                    </button>
                </div>
            </div>

            <div class="card-body p-0">
                <table class="table table-hover mb-0 text-center">
                    <thead class="thead-light">
                        <tr>
                            <th style="width:50px">#</th>
                            <th>Bác sĩ</th>
                            <th style="width:120px">Số lịch</th>
                        </tr>
                    </thead>
                    <tbody id="doctorStatBody">
                        <tr>
                            <td colspan="3" class="text-muted py-4">
                                Chưa có dữ liệu
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="d-flex justify-content-between align-items-center px-3 py-2">
                    <small class="text-muted" id="paginationInfo"></small>

                    <nav>
                        <ul class="pagination pagination-sm mb-0" id="pagination">
                        </ul>
                    </nav>
                </div>
            </div>

        </div>
    </div>

    <!-- AREA CHART -->
    <div class="col-xl-8 col-lg-7 mb-4">
        <div class="card shadow h-100">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    Thống kê đặt lịch 10 ngày gần nhất
                </h6>
            </div>
            <div class="card-body">
                <div class="chart-area">
                    <canvas id="bookingChart"></canvas>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- PIE CHART ROW -->
<div class="row">
    <div class="col-xl-4 col-lg-5">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    Tỷ lệ lịch đặt
                </h6>
            </div>
            <div class="card-body">
                <div class="chart-pie pt-4 pb-2">
                    <canvas id="appointmentPieChart"></canvas>
                </div>
                <div id="totalCount"
                     class="mt-4 text-center font-weight-bold text-gray">
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js -->
    <script src="~/js/Chart.min.js"></script>

    <!-- Dashboard JS -->
    <script src="~/js/dashboard.js"></script>
}
