                               class="media-logo-card">
                                <img src="/images/vnexpress.png" alt="VNExpress">
                            </a>
                        </div>

                        <div class="col-6">
                            <a href="https://suckhoedoisong.vn/dat-lich-kham-benh-tiet-kiem-thong-minh-va-hieu-qua-169153232.htm"
                               target="_blank"
                               class="media-logo-card">
                                <img src="/images/suckhoedoisong.png" alt="Sức khỏe & Đời sống">
                            </a>
                        </div>

                        <div class="col-6">
                            <a href="https://vietnamnet.vn/nen-tang-dat-lich-kham-online-bookingcare-muon-tang-truong-nguoi-dung-gap-5-lan-nam-2017-i370270.html"
